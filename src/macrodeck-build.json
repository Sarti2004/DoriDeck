{
  "version": 1,
  "include": ["mhyph.txt","Assets/Keys/accidental-idle.png", 
    "Assets/Keys/accidental-pressed.png", 
    "Assets/Keys/natural-idle.png", "Assets/Keys/natural-pressed.png",
    "Assets/Durations/whole.png", "Assets/Durations/half.png", "Assets/Durations/quarter.png",
    "Assets/Durations/eighth.png", "Assets/Durations/sixteenth.png", "Assets/Durations/thirty-second.png"],
  "targets": {
    "win-x64": {
      "executable": "dotnet",
      "arguments": ["publish", "DoriDeck.csproj", "-c", "Release", "-r", "win-x64",
                    "--self-contained", "false", "-p:UseAppHost=false",
                    "-o", "bin/publish/win-x64"],
      "output": "bin/publish/win-x64"
    },
    "osx-arm64": {
      "executable": "dotnet",
      "arguments": ["publish", "DoriDeck.csproj", "-c", "Release", "-r", "osx-arm64",
                    "--self-contained", "false", "-p:UseAppHost=false",
                    "-o", "bin/publish/osx-arm64"],
      "output": "bin/publish/osx-arm64"
    }
  }
}
